{
  "name": "jungle-gaming-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering processor built with NestJS, Bun and PostgreSQL",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:e2e": "bun test test/app.e2e.spec.ts test/integration/wagering-api.e2e.spec.ts test/integration/observability.e2e.spec.ts",
    "test:e2e:http": "bun test test/app.e2e.spec.ts test/integration/wagering-api.e2e.spec.ts",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:smoke": "bun test test/smoke",
    "test:load": "k6 run --summary-trend-stats \"avg,min,med,p(90),p(95),p(99),max\" load/k6.js",
    "test:load:full": "bash scripts/load-test.sh",
    "test:load:docker": "docker run --rm -i --network host -v \"$PWD/load:/scripts:ro\" -e K6_BASE_URL -e K6_PLAYER_ID -e K6_WALLET_ID -e K6_PROVIDER_ID -e K6_CURRENCY -e K6_AMOUNT -e K6_VUS -e K6_DURATION -e K6_SLEEP_SECONDS grafana/k6 run --summary-trend-stats \"avg,min,med,p(90),p(95),p(99),max\" /scripts/k6.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:up": "bun run scripts/migration-up.ts",
    "migration:down": "bun run scripts/migration-down.ts",
    "migration:create": "bun run scripts/migration-create.ts",
    "sqs:send": "bun run scripts/sqs-send.ts",
    "retention:purge": "bun run scripts/retention-purge.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1159.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "ajv": "8.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
