# HTTP
PORT=3000
INSTANCE_ID=local-dev
LOG_LEVEL=INFO

# PostgreSQL (o default local já é este; mantenha comentado para não
# sobrescrever o DATABASE_URL interno definido pelo Compose)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering

# SQS / LocalStack
SQS_ENDPOINT=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Filas. Se omitidas, são derivadas de SQS_ENDPOINT.
# SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# SQS_WAGER_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
# SQS_EVENTS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wagering-events-dlq.fifo

# Consumer / workers
MESSAGING_ENABLED=0
SQS_CONSUMER_NAME=wager-transactions
SQS_VISIBILITY_TIMEOUT=60
SQS_MAX_NUMBER_OF_MESSAGES=1
SQS_CONSUMER_MAX_RECEIVE_COUNT=5
MESSAGING_POLL_INTERVAL_MS=1000
MESSAGING_DRAIN_TIMEOUT_MS=30000
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_CONCURRENCY=4
PENDING_LEASE_MS=30000
PENDING_BATCH_SIZE=10

# Falhas injetadas (testes)
FAULT_AFTER_COMMIT_BEFORE_ACK=0
FAULT_AFTER_PUBLISH_BEFORE_MARK=0

# Métricas / migrations
# METRICS_DLQ_ENABLED segue MESSAGING_ENABLED quando omitido.
# METRICS_DLQ_ENABLED=1
METRICS_DLQ_INTERVAL_MS=15000
MIGRATIONS_PATH=src/infrastructure/persistence/migrations

# Retenção (script opt-in; dry-run por padrão)
RETENTION_INBOX_DAYS=30
RETENTION_OUTBOX_DAYS=90
RETENTION_BATCH_SIZE=1000
